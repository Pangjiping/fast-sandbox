# Extend a Debian/Ubuntu builder or Fastlet image with the fsb-vm OCI tools.
# Build the Go commands into .build/linux-amd64 and native tools into
# .build/oci-tools using scripts/build-oci-tools.sh on Linux first.
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}
ARG COMPONENT=fastlet
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl e2fsprogs iproute2 iptables libaio1 libcurl4 libgflags2.2 libglib2.0-0 libnl-3-200 libnl-genl-3-200 libssl3 libzstd1 mount util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY .build/oci-tools/ /opt/overlaybd/
COPY .build/linux-amd64/fsb-vm /usr/local/bin/fsb-vm
COPY .build/linux-amd64/convertor /usr/local/bin/convertor
COPY .build/linux-amd64/${COMPONENT} /usr/local/bin/runtime-component
COPY .build/linux-amd64/sandbox-init /opt/fast-sandbox/bin/sandbox-init
COPY build/oci/overlaybd.json /etc/overlaybd/ublkd.json
RUN sed 's/"enable": true, "uriPrefix"/"enable": false, "uriPrefix"/' /etc/overlaybd/ublkd.json > /etc/overlaybd/overlaybd.json
COPY build/oci/entrypoint.sh /usr/local/bin/oci-entrypoint
RUN chmod 0755 /usr/local/bin/oci-entrypoint
ENV LD_LIBRARY_PATH=/opt/overlaybd/lib
ENV PATH=/opt/overlaybd/bin:${PATH}
ENTRYPOINT ["/usr/local/bin/oci-entrypoint", "/usr/local/bin/runtime-component"]
